<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.akiyama.backend.practice.mapper.UserMapper">
    <!-- ユーザー検索 -->
    <select id="findByUsername" resultType="com.akiyama.backend.practice.domain.entity.User">
        SELECT
            id,
            username,
            password,
            role,
            enabled
        FROM users
        WHERE username = #{username}
    </select>

    <!-- ユーザー登録 -->
    <insert id="insertUser" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO users (
            username,
            password,
            role,
            enabled
        )
        VALUES (
            #{username},
            #{password},
            #{role},
            #{enabled}
        )
    </insert>
</mapper>